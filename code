using System;
using System.Collections.Generic;

namespace ConsoleApp1
{
    internal class Program
    {
        // Задание 1.2
        public int SumLastNums(int x)
        {
            return x % 10 + (x / 10) % 10;
        }

        // Задание 1.4
        public bool IsPositive(int x)
        {
            return x > 0;
        }

        // Задание 1.6
        public bool IsUpperCase(char x)
        {
            return x >= 'A' && x <= 'Z';
        }

        // Задание 1.8
        public bool IsDivisor(int a, int b)
        {
            if (a == 0 && b == 0)
            {
                return false;
            }
            if (a == 0 || b == 0)
            {
                return true;
            }

            return a % b == 0 || b % a == 0;
        }

        // Задание 1.10
        public int LastNumSum(int a, int b)
        {
            return a % 10 + b % 10;
        }

        // Задание 2.2
        public double SafeDiv(int x, int y)
        {
            if (y == 0)
            {
                return 0;
            }

            return (double)x / y;
        }

        // Задание 2.4
        public string MakeDecision(int x, int y)
        {
            if (x > y)
            {
                return $"{x} > {y}";
            }

            if (x < y)
            {
                return $"{x} < {y}";
            }

            return $"{x} == {y}";
        }

        // Задание 2.6
        public bool Sum3(int x, int y, int z)
        {
            return x + y == z || x + z == y || y + z == x;
        }

        // Задание 2.8
        public string Age(int x)
        {
            if (x % 10 == 1 && x % 100 != 11)
            {
                return $"{x} год";
            }

            if (x % 10 >= 2 && x % 10 <= 4 && (x % 100 < 11 || x % 100 > 14))
            {
                return $"{x} года";
            }

            return $"{x} лет";
        }

        // Задание 2.10
        public void PrintDays(string x)
        {
            switch (x)
            {
                case "понедельник":
                    Console.WriteLine("понедельник");
                    goto case "вторник";
                case "вторник":
                    Console.WriteLine("вторник");
                    goto case "среда";
                case "среда":
                    Console.WriteLine("среда");
                    goto case "четверг";
                case "четверг":
                    Console.WriteLine("четверг");
                    goto case "пятница";
                case "пятница":
                    Console.WriteLine("пятница");
                    goto case "суббота";
                case "суббота":
                    Console.WriteLine("суббота");
                    goto case "воскресенье";
                case "воскресенье":
                    Console.WriteLine("воскресенье");
                    break;
                default:
                    Console.WriteLine("это не день недели");
                    break;
            }
        }

        // Задание 3.2
        public string ReverseListNums(int x)
        {
            string result = "";
            for (int i = x; i >= 0; i--)
            {
                result += i + " ";
            }

            return result;
        }

        // Задание 3.4
        public int Pow(int x, int y)
        {
            int result = 1;
            for (int i = 0; i < y; i++)
            {
                result *= x;
            }

            return result;
        }

        // Задание 3.6
        public bool EqualNum(int x)
        {
            int digit = x % 10;
            while (x > 0)
            {
                if (x % 10 != digit)
                {
                    return false;
                }

                x /= 10;
            }

            return true;
        }

        // Задание 3.8
        public void LeftTriangle(int x)
        {
            for (int i = 1; i <= x; i++)
            {
                Console.WriteLine(new string('*', i));
            }
        }

        // Задание 3.10
        public void GuessGame()
        {
            Random random = new Random();
            int number = random.Next(0, 10);
            int guess = -1;
            int attempts = 0;

            while (guess != number)
            {
                Console.WriteLine("Введите число от 0 до 9:");
                while (!int.TryParse(Console.ReadLine(), out guess) || guess < 0 || guess > 9)
                {
                    Console.WriteLine("Неправильный ввод, введите число от 0 до 9:");
                }

                attempts++;
                if (guess != number)
                {
                    Console.WriteLine("Вы не угадали.");
                }
            }

            Console.WriteLine("Вы угадали!");
            Console.WriteLine($"Количество попыток: {attempts}");
        }

        // Задание 4.2
        public int FindLast(int[] arr, int x)
        {
            int index = -1;
            for (int i = 0; i < arr.Length; i++)
            {
                if (arr[i] == x)
                {
                    index = i;
                }
            }

            return index;
        }

        // Задание 4.4
        public int[] Add(int[] arr, int x, int pos)
        {
            List<int> result = new List<int>();
            for (int i = 0; i < arr.Length; i++)
            {
                if (i == pos)
                {
                    result.Add(x);
                }

                result.Add(arr[i]);
            }

            if (pos == arr.Length)
            {
                result.Add(x);
            }

            return result.ToArray();
        }

        // Задание 4.6
        public void Reverse(int[] arr)
        {
            for (int i = 0; i < arr.Length / 2; i++)
            {
                int temp = arr[i];
                arr[i] = arr[arr.Length - 1 - i];
                arr[arr.Length - 1 - i] = temp;
            }
        }

        // Задание 4.8
        public int[] Concat(int[] arr1, int[] arr2)
        {
            List<int> result = new List<int>();
            for (int i = 0; i < arr1.Length; i++)
            {
                result.Add(arr1[i]);
            }

            for (int i = 0; i < arr2.Length; i++)
            {
                result.Add(arr2[i]);
            }

            return result.ToArray();
        }

        // Задание 4.10
        public int[] DeleteNegative(int[] arr)
        {
            List<int> result = new List<int>();
            for (int i = 0; i < arr.Length; i++)
            {
                if (arr[i] >= 0)
                {
                    result.Add(arr[i]);
                }
            }

            return result.ToArray();
        }

        // Вспомогательный метод: ввод целого числа с проверкой.
        private int ReadInt(string message)
        {
            int n;
            Console.Write(message);
            while (!int.TryParse(Console.ReadLine(), out n))
            {
                Console.Write("Ошибка, введите целое число: ");
            }

            return n;
        }

        // Вспомогательный метод: ввод целого числа в диапазоне.
        private int ReadIntInRange(string message, int min, int max)
        {
            int n = ReadInt(message);
            while (n < min || n > max)
            {
                n = ReadInt($"Число должно быть от {min} до {max}: ");
            }

            return n;
        }

        // Вспомогательный метод: ввод одного символа.
        private char ReadChar(string message)
        {
            char c;
            Console.Write(message);
            while (!char.TryParse(Console.ReadLine(), out c))
            {
                Console.Write("Ошибка, введите ровно один символ: ");
            }

            return c;
        }

        // Ввод массива
        private int[] ReadArray(string name)
        {
            int n = ReadIntInRange($"Введите количество элементов {name}: ", 0, 1000);
            int[] arr = new int[n];
            for (int i = 0; i < n; i++)
            {
                arr[i] = ReadInt($"Введите элемент {name}[{i}]: ");
            }

            return arr;
        }

        // Проверка ввода меню
        private bool IsValidChoice(string choice)
        {
            string[] valid =
            {
                "0", "1.2", "1.4", "1.6", "1.8", "1.10",
                "2.2", "2.4", "2.6", "2.8", "2.10",
                "3.2", "3.4", "3.6", "3.8", "3.10",
                "4.2", "4.4", "4.6", "4.8", "4.10"
            };

            return Array.IndexOf(valid, choice) >= 0;
        }

        // Вывод меню
        private void PrintMenu()
        {
            Console.WriteLine();
            Console.WriteLine("Выберите задание:");
            Console.WriteLine("1.2  - SumLastNums");
            Console.WriteLine("1.4  - IsPositive");
            Console.WriteLine("1.6  - IsUpperCase");
            Console.WriteLine("1.8  - IsDivisor");
            Console.WriteLine("1.10 - LastNumSum (пять чисел)");
            Console.WriteLine("2.2  - SafeDiv");
            Console.WriteLine("2.4  - MakeDecision");
            Console.WriteLine("2.6  - Sum3");
            Console.WriteLine("2.8  - Age");
            Console.WriteLine("2.10 - PrintDays");
            Console.WriteLine("3.2  - ReverseListNums");
            Console.WriteLine("3.4  - Pow");
            Console.WriteLine("3.6  - EqualNum");
            Console.WriteLine("3.8  - LeftTriangle");
            Console.WriteLine("3.10 - GuessGame");
            Console.WriteLine("4.2  - FindLast");
            Console.WriteLine("4.4  - Add");
            Console.WriteLine("4.6  - Reverse");
            Console.WriteLine("4.8  - Concat");
            Console.WriteLine("4.10 - DeleteNegative");
            Console.WriteLine("0    - Выход");
            Console.Write("Ваш выбор: ");
        }

        private static void Main()
        {
            Program p = new Program();
            string choice = "";

            while (choice != "0")
            {
                p.PrintMenu();
                choice = Console.ReadLine() ?? "";

                while (!p.IsValidChoice(choice))
                {
                    Console.Write("Неверный пункт меню, повторите ввод: ");
                    choice = Console.ReadLine() ?? "";
                }

                Console.WriteLine();

                switch (choice)
                {
                    case "1.2":
                        {
                            int x = p.ReadInt("Введите число (не меньше двух цифр): ");
                            while (Math.Abs(x) < 10)
                            {
                                x = p.ReadInt("В числе должно быть не меньше двух цифр: ");
                            }

                            Console.WriteLine($"Результат: {p.SumLastNums(x)}");
                            break;
                        }
                    case "1.4":
                        {
                            int x = p.ReadInt("Введите число x: ");
                            Console.WriteLine($"Результат: {p.IsPositive(x)}");
                            break;
                        }
                    case "1.6":
                        {
                            char x = p.ReadChar("Введите символ x: ");
                            Console.WriteLine($"Результат: {p.IsUpperCase(x)}");
                            break;
                        }
                    case "1.8":
                        {
                            int a = p.ReadInt("Введите число a: ");
                            int b = p.ReadInt("Введите число b: ");
                            Console.WriteLine($"Результат: {p.IsDivisor(a, b)}");
                            break;
                        }
                    case "1.10":
                        {
                            int result = p.ReadInt("Введите 1-е число: ");
                            for (int i = 2; i <= 5; i++)
                            {
                                int next = p.ReadInt($"Введите {i}-е число: ");
                                Console.Write($"{result}+{next} это ");
                                result = p.LastNumSum(result, next);
                                Console.WriteLine(result);
                            }

                            Console.WriteLine($"Итого {result}");
                            break;
                        }
                    case "2.2":
                        {
                            int x = p.ReadInt("Введите число x: ");
                            int y = p.ReadInt("Введите число y: ");
                            Console.WriteLine($"Результат: {p.SafeDiv(x, y)}");
                            break;
                        }
                    case "2.4":
                        {
                            int x = p.ReadInt("Введите число x: ");
                            int y = p.ReadInt("Введите число y: ");
                            Console.WriteLine($"Результат: {p.MakeDecision(x, y)}");
                            break;
                        }
                    case "2.6":
                        {
                            int x = p.ReadInt("Введите число x: ");
                            int y = p.ReadInt("Введите число y: ");
                            int z = p.ReadInt("Введите число z: ");
                            Console.WriteLine($"Результат: {p.Sum3(x, y, z)}");
                            break;
                        }
                    case "2.8":
                        {
                            int x = p.ReadIntInRange("Введите возраст x: ", 0, int.MaxValue);
                            Console.WriteLine($"Результат: {p.Age(x)}");
                            break;
                        }
                    case "2.10":
                        {
                            Console.Write("Введите день недели (строчными буквами): ");
                            string x = Console.ReadLine() ?? "";
                            p.PrintDays(x);
                            break;
                        }
                    case "3.2":
                        {
                            int x = p.ReadIntInRange("Введите число x (не меньше 0): ", 0, int.MaxValue);
                            Console.WriteLine($"Результат: {p.ReverseListNums(x)}");
                            break;
                        }
                    case "3.4":
                        {
                            int x = p.ReadInt("Введите число x: ");
                            int y = p.ReadIntInRange("Введите степень y (не меньше 0): ", 0, int.MaxValue);
                            Console.WriteLine($"Результат: {p.Pow(x, y)}");
                            break;
                        }
                    case "3.6":
                        {
                            int x = p.ReadIntInRange("Введите число x (не меньше 0): ", 0, int.MaxValue);
                            Console.WriteLine($"Результат: {p.EqualNum(x)}");
                            break;
                        }
                    case "3.8":
                        {
                            int x = p.ReadIntInRange("Введите высоту x (не меньше 1): ", 1, 100);
                            p.LeftTriangle(x);
                            break;
                        }
                    case "3.10":
                        {
                            p.GuessGame();
                            break;
                        }
                    case "4.2":
                        {
                            int[] arr = p.ReadArray("arr");
                            int x = p.ReadInt("Введите искомое число x: ");
                            Console.WriteLine($"Результат: {p.FindLast(arr, x)}");
                            break;
                        }
                    case "4.4":
                        {
                            int[] arr = p.ReadArray("arr");
                            int x = p.ReadInt("Введите число x: ");
                            int pos = p.ReadIntInRange($"Введите позицию pos (от 0 до {arr.Length}): ", 0, arr.Length);
                            int[] result = p.Add(arr, x, pos);
                            Console.WriteLine($"Результат: [{string.Join(", ", result)}]");
                            break;
                        }
                    case "4.6":
                        {
                            int[] arr = p.ReadArray("arr");
                            p.Reverse(arr);
                            Console.WriteLine($"Результат: [{string.Join(", ", arr)}]");
                            break;
                        }
                    case "4.8":
                        {
                            int[] arr1 = p.ReadArray("arr1");
                            int[] arr2 = p.ReadArray("arr2");
                            int[] result = p.Concat(arr1, arr2);
                            Console.WriteLine($"Результат: [{string.Join(", ", result)}]");
                            break;
                        }
                    case "4.10":
                        {
                            int[] arr = p.ReadArray("arr");
                            int[] result = p.DeleteNegative(arr);
                            Console.WriteLine($"Результат: [{string.Join(", ", result)}]");
                            break;
                        }
                    case "0":
                        {
                            Console.WriteLine("Выход из программы.");
                            break;
                        }
                }
            }
        }
    }
}
